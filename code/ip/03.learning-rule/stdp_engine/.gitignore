# Generated simulation data — regenerate with `make mnist_prepare`
*.hex
tb/*.hex
tb/mnist_config.vh

# MNIST source data — fetch with `make download_mnist`
data/mnist/

# Build + simulation artifacts
build/
*.vvp
*.vcd
a.out
out*.log

# archived run outputs are kept, but not the bulky per-run spike data
runs/**/*.hex

# A run.log IS the experiment record - the root .gitignore *.log rule was
# silently dropping all of them, leaving only INFO.txt headlines.
!runs/**/*.log
